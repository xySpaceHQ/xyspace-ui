{
	"name": "xyspace-ui",
	"version": "0.2.3",
	"type": "module",
	"packageManager": "pnpm@10.27.0",
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xySpaceHQ/xyspace-ui.git"
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./icons": {
			"import": {
				"types": "./dist/icons/index.d.mts",
				"default": "./dist/icons/index.mjs"
			},
			"require": {
				"types": "./dist/icons/index.d.cts",
				"default": "./dist/icons/index.cjs"
			}
		},
		"./style.css": "./dist/style.css"
	},
	"scripts": {
		"prepare": "node scripts/copy-maplibre-worker.mjs",
		"prebuild": "rm -rf dist && node scripts/build-css.mjs",
		"build": "tsdown",
		"postbuild": "node scripts/copy-maplibre-worker.mjs dist && node scripts/inject-css-import.mjs",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"chromatic": "chromatic --exit-zero-on-changes"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-mcp": "latest",
		"@storybook/addon-themes": "^10.6.0",
		"@storybook/addon-vitest": "^10.6.0",
		"@storybook/react-vite": "^10.6.0",
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-scale": "4.0.9",
		"@types/geojson": "7946.0.16",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/browser-playwright": "latest",
		"@vitest/coverage-v8": "latest",
		"autoprefixer": "^10.5.5",
		"chromatic": "^18.7.4",
		"esbuild": "^0.28.2",
		"playwright": "latest",
		"postcss": "^8.5.28",
		"publint": "^0.3.24",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"storybook": "^10.6.0",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.22.14",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"unrun": "^0.3.1",
		"vitest": "latest"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@geomatico/maplibre-cog-protocol": "^0.9.3",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-table": "^8.21.3",
		"@vis.gl/react-maplibre": "^8.1.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.575.0",
		"maplibre-gl": "6.3.0",
		"radix-ui": "^1.6.7",
		"tailwind-merge": "^3.6.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": false
		},
		"react-dom": {
			"optional": false
		}
	}
}